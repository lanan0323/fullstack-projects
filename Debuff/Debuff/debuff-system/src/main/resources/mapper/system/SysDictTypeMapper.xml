<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!-- 对应 Mapper 接口：com.debuff.system.mapper.SysDictTypeMapper -->
<!-- 功能：字典类型（SysDictType）的增删改查，管理字典分类（如sys_order_status、sys_pay_type等） -->
<mapper namespace="com.debuff.system.mapper.SysDictTypeMapper">

	<!-- 结果映射：将 sys_dict_type 表的数据库列名映射到 SysDictType 实体属性 -->
	<resultMap type="SysDictType" id="SysDictTypeResult">
		<id     property="dictId"     column="dict_id"     />
		<result property="dictName"   column="dict_name"   />
		<result property="dictType"   column="dict_type"   />
		<result property="status"     column="status"      />
		<result property="createBy"   column="create_by"   />
		<result property="createTime" column="create_time" />
		<result property="updateBy"   column="update_by"   />
		<result property="updateTime" column="update_time" />
	</resultMap>
	
	<!-- SQL片段：字典类型基础查询语句，可被其他SQL通过include复用 -->
	<sql id="selectDictTypeVo">
        select dict_id, dict_name, dict_type, status, create_by, create_time, remark 
		from sys_dict_type
    </sql>

	<!-- 查询字典类型列表：支持按名称/状态/类型编码筛选，支持按创建时间范围过滤 -->
	<select id="selectDictTypeList" parameterType="SysDictType" resultMap="SysDictTypeResult">
	    <include refid="selectDictTypeVo"/>
		<where>
		    <!-- 条件筛选：按字典名称模糊匹配 -->
		    <if test="dictName != null and dictName != ''">
				AND dict_name like concat('%', #{dictName}, '%')
			</if>
			<!-- 条件筛选：按状态精确匹配 -->
			<if test="status != null and status != ''">
				AND status = #{status}
			</if>
			<!-- 条件筛选：按字典类型编码模糊匹配 -->
			<if test="dictType != null and dictType != ''">
				AND dict_type like concat('%', #{dictType}, '%')
			</if>
			<!-- 条件筛选：按创建时间范围-开始时间 -->
			<if test="params.beginTime != null and params.beginTime != ''">
				and date_format(create_time,'%y%m%d') &gt;= date_format(#{params.beginTime},'%y%m%d')
			</if>
			<!-- 条件筛选：按创建时间范围-结束时间 -->
			<if test="params.endTime != null and params.endTime != ''">
				and date_format(create_time,'%y%m%d') &lt;= date_format(#{params.endTime},'%y%m%d')
			</if>
	    </where>
	</select>
	
	<!-- 查询所有字典类型（无筛选条件） -->
	<select id="selectDictTypeAll" resultMap="SysDictTypeResult">
		<include refid="selectDictTypeVo"/>
	</select>
	
	<!-- 根据ID查询单个字典类型 -->
	<select id="selectDictTypeById" parameterType="Long" resultMap="SysDictTypeResult">
		<include refid="selectDictTypeVo"/>
		where dict_id = #{dictId}
	</select>
	
	<!-- 根据字典类型编码查询：用于获取某个字典分类的详细信息 -->
	<select id="selectDictTypeByType" parameterType="String" resultMap="SysDictTypeResult">
		<include refid="selectDictTypeVo"/>
		where dict_type = #{dictType}
	</select>
	
	<!-- 校验字典类型编码是否唯一：查询指定编码的记录，取第一条判断是否存在 -->
	<select id="checkDictTypeUnique" parameterType="String" resultMap="SysDictTypeResult">
		<include refid="selectDictTypeVo"/>
		where dict_type = #{dictType} limit 1
	</select>
	
	<!-- 根据ID删除单个字典类型 -->
	<delete id="deleteDictTypeById" parameterType="Long">
 		delete from sys_dict_type where dict_id = #{dictId}
 	</delete>
 	
 	<!-- 批量删除字典类型：通过foreach遍历ID数组，生成IN子句 -->
 	<delete id="deleteDictTypeByIds" parameterType="Long">
 		delete from sys_dict_type where dict_id in
 		<foreach collection="array" item="dictId" open="(" separator="," close=")">
 			#{dictId}
        </foreach> 
 	</delete>

    <!-- 修改字典类型：动态SET，只更新非空字段 -->
 	<update id="updateDictType" parameterType="SysDictType">
 		update sys_dict_type
 		<set>
 			<if test="dictName != null and dictName != ''">dict_name = #{dictName},</if>
 			<if test="dictType != null and dictType != ''">dict_type = #{dictType},</if>
 			<if test="status != null">status = #{status},</if>
 			<if test="remark != null">remark = #{remark},</if>
 			<if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
 			update_time = sysdate()
 		</set>
 		where dict_id = #{dictId}
 	</update>
 	
 	<!-- 新增字典类型：动态插入非空字段，create_time使用sysdate()自动填充 -->
 	<insert id="insertDictType" parameterType="SysDictType">
 		insert into sys_dict_type(
 			<if test="dictName != null and dictName != ''">dict_name,</if>
 			<if test="dictType != null and dictType != ''">dict_type,</if>
 			<if test="status != null">status,</if>
 			<if test="remark != null and remark != ''">remark,</if>
 			<if test="createBy != null and createBy != ''">create_by,</if>
 			create_time
 		)values(
 			<if test="dictName != null and dictName != ''">#{dictName},</if>
 			<if test="dictType != null and dictType != ''">#{dictType},</if>
 			<if test="status != null">#{status},</if>
 			<if test="remark != null and remark != ''">#{remark},</if>
 			<if test="createBy != null and createBy != ''">#{createBy},</if>
 			sysdate()
 		)
 	</insert>
 	
</mapper> 
