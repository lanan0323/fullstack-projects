<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!-- 对应 Mapper 接口：com.debuff.system.mapper.SysRoleMenuMapper -->
<!-- 功能：角色-菜单关联表（sys_role_menu）的操作，管理角色与菜单权限的对应关系 -->
<mapper namespace="com.debuff.system.mapper.SysRoleMenuMapper">

	<!-- 结果映射：角色-菜单关联的简单映射，只有角色ID和菜单ID两个字段 -->
	<resultMap type="SysRoleMenu" id="SysRoleMenuResult">
		<result property="roleId"     column="role_id"      />
		<result property="menuId"     column="menu_id"      />
	</resultMap>
	
    <!-- 检查菜单是否被角色引用：删除菜单前校验，有关联的角色需要先处理 -->
	<select id="checkMenuExistRole" resultType="Integer">
	    select count(1) from sys_role_menu where menu_id = #{menuId}
	</select>

    <!-- 根据角色ID删除角色-菜单关联：角色编辑时先清除旧关联，再重新插入新关联 -->
	<delete id="deleteRoleMenuByRoleId" parameterType="Long">
		delete from sys_role_menu where role_id=#{roleId}
	</delete>
	
    <!-- 批量删除角色-菜单关联：通过foreach遍历角色ID数组，删除多个角色的所有关联 -->
	<delete id="deleteRoleMenu" parameterType="Long">
 		delete from sys_role_menu where role_id in
 		<foreach collection="array" item="roleId" open="(" separator="," close=")">
 			#{roleId}
        </foreach> 
 	</delete>
	
    <!-- 批量插入角色-菜单关联：角色编辑时重新分配菜单权限，一条INSERT语句插入多条记录 -->
	<insert id="batchRoleMenu">
		insert into sys_role_menu(role_id, menu_id) values
		<foreach item="item" index="index" collection="list" separator=",">
			(#{item.roleId},#{item.menuId})
		</foreach>
	</insert>
	
</mapper>
