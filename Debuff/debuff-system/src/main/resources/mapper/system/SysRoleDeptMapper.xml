<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!-- 对应 Mapper 接口：com.debuff.system.mapper.SysRoleDeptMapper -->
<!-- 功能：角色与部门关联关系管理，维护 sys_role_dept 中间表，支持角色-部门绑定的增删查操作 -->
<mapper namespace="com.debuff.system.mapper.SysRoleDeptMapper">

	<!-- 结果映射：将 sys_role_dept 表的 role_id 和 dept_id 映射到 SysRoleDept 实体 -->
	<resultMap type="SysRoleDept" id="SysRoleDeptResult">
		<result property="roleId"     column="role_id"      />
		<result property="deptId"     column="dept_id"      />
	</resultMap>

	<!-- 根据角色ID删除角色-部门关联：删除指定角色的所有部门绑定关系，通常在修改角色权限时先清除再重建 -->
	<delete id="deleteRoleDeptByRoleId" parameterType="Long">
		delete from sys_role_dept where role_id=#{roleId}
	</delete>
	
	<!-- 根据部门ID统计关联角色数量：检查该部门是否被角色引用，用于删除部门前的校验 -->
	<select id="selectCountRoleDeptByDeptId" resultType="Integer">
	    select count(1) from sys_role_dept where dept_id=#{deptId}
	</select>
	
	<!-- 批量删除角色-部门关联：按角色ID数组批量删除，删除多个角色时一次性清除所有关联 -->
	<delete id="deleteRoleDept" parameterType="Long">
 		delete from sys_role_dept where role_id in
 		<foreach collection="array" item="roleId" open="(" separator="," close=")">
 			#{roleId}
        </foreach> 
 	</delete>
	
	<!-- 批量新增角色-部门关联：为角色分配多个部门权限，使用 foreach 拼接多行 VALUES 实现批量插入 -->
	<insert id="batchRoleDept">
		insert into sys_role_dept(role_id, dept_id) values
		<foreach item="item" index="index" collection="list" separator=",">
			(#{item.roleId},#{item.deptId})
		</foreach>
	</insert>
	
</mapper> 